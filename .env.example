SYNCBRIDGE_API_TOKEN=replace-with-a-long-random-token
SYNCBRIDGE_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
SYNCBRIDGE_DESTINATION=rest
SYNCBRIDGE_FIELD_MAP=config/field-map.example.json
DESTINATION_URL=https://your-system.example/api/import
DESTINATION_TOKEN=replace-with-destination-token
